@using Microsoft.AspNetCore.Identity
@using ScorelyApp.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="nav nav-pills flex gap-6">
    <li class="nav-item">
        <NavLink class=@navClass href="Account/Manage" Match="NavLinkMatch.All" ActiveClass=@navClassActive>
            Profile
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class=@navClass href="Account/Manage/Email" ActiveClass=@navClassActive>
            Email
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class=@navClass href="Account/Manage/ChangePassword" ActiveClass=@navClassActive>
            Password
        </NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <NavLink class=@navClass href="Account/Manage/ExternalLogins" ActiveClass=@navClassActive>
                External logins
            </NavLink>
        </li>
    }
    <li class="nav-item">
        <NavLink class=@navClass href="Account/Manage/TwoFactorAuthentication" ActiveClass=@navClassActive>
            Two-factor authentication
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class=@navClass href="Account/Manage/PersonalData" ActiveClass=@navClassActive>
            Personal data
        </NavLink>
    </li>
</ul>

@code {
    private string navClass = "text-gray-400 px-4 py-2 rounded-full transition-all hover:bg-teal-900 hover:text-white";
    private string navClassActive = "bg-teal-900 text-white hover:opacity-75";
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
